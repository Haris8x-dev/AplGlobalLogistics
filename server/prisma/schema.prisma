// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  phoneNumber String?
  password    String
  role        String   @default("EMPLOYEE")
  secretCode  String?

  stockMovements StockMovement[] // HISTORY: Every +/- that happened to this client
  clientStocks   ClientStock[]   // BALANCE: The actual current totals for this client
  isActive    Boolean  @default(true) // Added this
  createdAt   DateTime @default(now())
}


model Client {
  id          String   @id @default(uuid())
  companyName String
  contactName String?
  email       String   @unique
  phoneNumber String?
  address     String?
  industry    String?
  
  // Status-based "Soft Delete"
  isActive    Boolean  @default(true) 

 stockMovements StockMovement[] // HISTORY: Every +/- that happened to this client
 clientStocks   ClientStock[]   // BALANCE: The actual current totals for this client
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt], map: "idx_client_created_at")
  @@index([isActive], map: "idx_client_is_active")
}


model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  models    MobileModel[] // Relation link
  createdAt DateTime @default(now())

  @@index([isActive, name], map: "idx_category_active_name")
}


model MobileModel {
  id             String          @id @default(uuid())
  name           String
  categoryId     String
  isActive       Boolean         @default(true) // <--- Add this
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  clientStocks   ClientStock[]
  createdAt      DateTime        @default(now())

  @@index([categoryId, name], map: "idx_mobile_model_category_name")
}

model ClientStock {
  id             String      @id @default(uuid())
  currentBalance Int         @default(0)
  lastMessage    String?     // 🚀 Stores the most recent "Why"
  
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id])
  modelId        String
  model          MobileModel @relation(fields: [modelId], references: [id])

  lastUpdatedBy  String
  user           User        @relation(fields: [lastUpdatedBy], references: [id])

  updatedAt      DateTime    @updatedAt

  @@unique([clientId, modelId])
  @@index([clientId, currentBalance], map: "idx_client_stock_client_balance")
  @@index([modelId], map: "idx_client_stock_model")
}

enum MovementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model StockMovement {
  id              String   @id @default(uuid())
  quantity        Int
  transferType    String?
  message         String?
  jobNo           String?    // Job number (alphanumeric)
  awb             String?    // Air Waybill number
  movementDate    DateTime?  // Date entered by user

  status          MovementStatus @default(COMPLETED) // 🚀 Track transfer status

  transferGroupId String?   // 🔥 links both sides of transfer
  fromClientId    String?   // 🔥 structured tracking
  toClientId      String?   // 🔥 structured tracking

  modelId         String
  model           MobileModel @relation(fields: [modelId], references: [id])

  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])

  userId          String
  user            User        @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now())

  @@index([transferGroupId], map: "idx_stock_movement_transfer_group")
  @@index([clientId, modelId, createdAt], map: "idx_stock_movement_client_model_created")
  @@index([status, createdAt], map: "idx_stock_movement_status_created")
}

model AppConfig {
  id            String   @id @default("GLOBAL_CONFIG") // Only one record ever exists
  entryPassword String   // The hashed password to enter the app
  updatedAt     DateTime @updatedAt
}
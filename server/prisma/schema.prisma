// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  phoneNumber String?
  password    String
  role        String   @default("EMPLOYEE")
  secretCode  String?

  stockMovements StockMovement[] // HISTORY: Every +/- that happened to this client
  clientStocks   ClientStock[]   // BALANCE: The actual current totals for this client
  isActive    Boolean  @default(true) // Added this
  createdAt   DateTime @default(now())
}


model Client {
  id          String   @id @default(uuid())
  companyName String
  contactName String?
  email       String   @unique
  phoneNumber String?
  address     String?
  industry    String?
  
  // Status-based "Soft Delete"
  isActive    Boolean  @default(true) 

 stockMovements StockMovement[] // HISTORY: Every +/- that happened to this client
 clientStocks   ClientStock[]   // BALANCE: The actual current totals for this client
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  models    MobileModel[] // Relation link
  createdAt DateTime @default(now())
}


model MobileModel {
  id         String   @id @default(uuid())
  name       String   // e.g., "iPhone 16 Pro Max 256GB"
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[] // HISTORY: Every +/- that happened to this client
  clientStocks   ClientStock[]   // BALANCE: The actual current totals for this client
  createdAt  DateTime @default(now())
}

model ClientStock {
  id             String      @id @default(uuid())
  currentBalance Int         @default(0)
  lastMessage    String?     // 🚀 Stores the most recent "Why"
  
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id])
  modelId        String
  model          MobileModel @relation(fields: [modelId], references: [id])

  lastUpdatedBy  String
  user           User        @relation(fields: [lastUpdatedBy], references: [id])

  updatedAt      DateTime    @updatedAt

  @@unique([clientId, modelId])
}

model StockMovement {
  id              String   @id @default(uuid())
  quantity        Int
  transferType    String?
  message         String?

  transferGroupId String?   // 🔥 links both sides of transfer
  fromClientId    String?   // 🔥 structured tracking
  toClientId      String?   // 🔥 structured tracking

  modelId         String
  model           MobileModel @relation(fields: [modelId], references: [id])

  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])

  userId          String
  user            User        @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now())
}
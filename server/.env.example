# Copy this file to .env and fill the values for your environment.

# Server
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=hbbferhbghe2345678965@#$%^&54123

# Database (Option 1: full connection string)
# DATABASE_URL=postgresql://username:password@host:5432/database

# Database (Option 2: discrete values)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=root

# Optional: bootstrap key for first-time Gatekeeper password creation
# If set, POST /api/config/create-password can be called with header: X-Setup-Key
APP_SETUP_KEY=replace-with-one-time-setup-key
